# VexyloSchedule - Exemplo de Variáveis de Ambiente para Produção e Desenvolvimento
# Nunca coloque credenciais ou passwords reais neste ficheiro.

# 1. Base de Dados (Obrigatório em produção - PostgreSQL/Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# 2. Segurança Django
# Gerar uma chave forte com: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,.onrender.com
CANONICAL_HOST=yourdomain.com

# 3. Origens Confiáveis para CSRF (HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.onrender.com

# 4. Superuser Inicial (Opcional - Apenas na primeira inicialização)
CREATE_INITIAL_SUPERUSER=false
INITIAL_SUPERUSER_USERNAME=admin_user
INITIAL_SUPERUSER_EMAIL=admin@yourdomain.com
INITIAL_SUPERUSER_PASSWORD=strong-password-min-8-chars

# 5. Google OAuth 2.0 (Opcional para Login Social)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 6. Servidor de Email SMTP (Para envio de confirmações e recuperação de passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=suporte@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=suporte@yourdomain.com
